FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY candidate-solution/pyproject.toml /app/
COPY candidate-solution/pipeline/ /app/pipeline/

RUN pip install --no-cache-dir -e .

CMD ["python", "-m", "pipeline.etl_runner"]
