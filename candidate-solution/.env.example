# ==============================================================================
# GeoAI Analytics Environment Configuration
# ==============================================================================

# Location Service (Simulated Service)
LOCATION_SERVICE_HOST=location-service
LOCATION_SERVICE_PORT=8001
LOCATION_SERVICE_URL=http://location-service:8001

# Transaction Service (Simulated Service)
TRANSACTION_SERVICE_HOST=transaction-service
TRANSACTION_SERVICE_PORT=8002
TRANSACTION_SERVICE_INTERVAL=5

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8003
MCP_SERVER_URL=http://mcp-server:8003

# Agent Configuration
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_ENDPOINT=http://agent:8000/transactions

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gen_ai_agent_db
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password

# LLM Providers (Optional - An intelligent fallback engine runs automatically if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional: Specific model name in Ollama (e.g. llama3.2:3b, mistral, phi3). Leave blank to auto-detect whatever is installed.
OLLAMA_MODEL=

# Pipeline ETL Configuration
ETL_INTERVAL_SECONDS=10
ETL_BATCH_SIZE=500
